# ---- Option A: Gemini (best quality). Leave blank if you have no key. ----
GEMINI_API_KEY=

# ---- Option B: free local AI with Ollama (no key). Install from https://ollama.com then run:
#      ollama pull qwen2.5:3b
# OLLAMA_MODEL=qwen2.5:3b

# ---- Option C: do nothing. The app runs in "notes-only" mode. ----

# Advanced (optional): force a choice
# LLM_BACKEND=gemini|ollama|none
# EMBEDDING_BACKEND=gemini|chroma|local
